@page "/Profile"
@using Shared.Services
@using Shared.Models
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Profile -- CodeBase</PageTitle>

<div class="profile-container">
    <section class="profile-header">
        <p class="initials">
            <span>B</span>
        </p>
        <p class="user-info">
            <span class="name">@User.FullName</span>
            <span>@@@User.Username : @User.Email</span>
        </p>
    </section>
    <section class="user-overview">
        <div>
            <span>0</span>
            <span style="color:gray;">Day streak</span>
        </div>
        <div>
            <span>@User.TotalXp</span>
            <span style="color:gray;">Total XP</span>
        </div>
        <div>
            <span>@User.CurrentLevel</span>
            <span style="color:gray;">Developer level</span>
        </div>
        <div>
            <span>@User.TotalXp</span>
            <span style="color:gray;">Developer points</span>
        </div>
    </section>
</div>

@code {
    private User User { get; set; } = new();
    private string? errMsg;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return;

        var authResult = await AuthService.VerifyUserAsync();
        bool isAuthenticated = authResult.Data;
        if (!isAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var userDataServiceResult = await AuthService.GetUserDataAsync();

        if (userDataServiceResult.StatusCode == System.Net.HttpStatusCode.Unauthorized || 
            userDataServiceResult.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (userDataServiceResult.IsSuccess)
        {
            User = userDataServiceResult.Data;
            return;
        }

        errMsg = userDataServiceResult.ErrorMessage;
    }
}
