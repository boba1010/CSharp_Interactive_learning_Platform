@page "/Login"
@using Microsoft.AspNetCore.Authorization
@using CSharp_Interactive_Learning_App.Shared.Services
@using CSharp_Interactive_Learning_App.Shared.Contracts.Requests
@inject IAuthService AuthService
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<PageTitle>Login -- CodeBase</PageTitle>

<form class="login-form">
    <div>
        <input class="form-input" placeholder="Email" type="email" @bind-value="request.Email" />
    </div>
    <div>
        <input class="form-input" placeholder="Password" type="password" @bind-value="request.Password" />
    </div>
    <div>
        <button type="button" class="submit-btn" @onclick="LoginAsync">Login</button>
    </div>
    <a href="signup" class="form-link">Don't have an account? Create a new account!</a>
</form>

@code {
    UserLoginRequest request = new();
    string? errorMsg;

    private async Task LoginAsync()
    {
        var result = await AuthService.LoginAsync(request);
        var isLoggedIn = result.IsSuccess;

        if (isLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }
        errorMsg = result.ErrorMessage;
    }
}

