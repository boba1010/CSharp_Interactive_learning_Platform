@inject IJSRuntime JS
@using Shared.Contracts.Requests

<div class="battle-arena">
    <section class="arena">
        @for (int i = 0; i < EnemiesNumber; i++)
        {
            <span class="malware" style="margin: @ran.Next(50)px @ran.Next(700)px 0 @ran.Next(700)px;">👾</span>
        }
    </section>
    <section class="arena-UI">
        <span class="player-health">@PlayerHealth</span>
        <div class="editor">
            <textarea 
                @ref="textArea" 
                @bind="Request.Code"
                @bind:event="oninput"
                @bind:after="Resize"
                class="code-editor" 
                type="text" 
                rows="1" 
                autocorrect="off"
                spellcheck="false" />
            <button class="check-code-btn" @onclick="OnCheckCodeClick">Check code</button>
        </div>
    </section>
</div>

@code {
    [Parameter]
    public int EnemiesNumber { get; set; }
    [Parameter]
    public int PlayerHealth { get; set; }
    [Parameter]
    public EventCallback<RequestRoundCompletion> OnCheckCodeClicked { get; set; }

    private RequestRoundCompletion Request { get; set; } = new();
    private ElementReference textArea;
    private Random ran = new();

    private async Task OnCheckCodeClick()
    {
        await OnCheckCodeClicked.InvokeAsync(Request);
    }

    private async Task Resize()
    {
        await JS.InvokeVoidAsync("autoResize", textArea);
    }
}
