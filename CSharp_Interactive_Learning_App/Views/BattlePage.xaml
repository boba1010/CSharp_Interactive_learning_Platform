<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CSharp_Interactive_Learning_App.ViewModels"
             xmlns:convertors="clr-namespace:CSharp_Interactive_Learning_App.Convertors"
             x:Class="CSharp_Interactive_Learning_App.Views.BattlePage"
             x:DataType="viewmodels:BattleViewModel">
    <ContentPage.Resources>
        <convertors:VictoryConvertor x:Key="VictoryConvertor" />
    </ContentPage.Resources>
    
    <Grid
        RowDefinitions="Auto, *">
        <Grid
            Padding="0, 0, 5, 0"
            VerticalOptions="Start"
            ColumnDefinitions="Auto, *">
            <Button Text="&lt;="
                    BackgroundColor="Transparent"
                    TextColor="Grey"
                    FontSize="16"
                    Padding="0" 
                    Command="{Binding RequestBattleEndCommand}" />
            <ProgressBar 
                Grid.Column="1"
                Progress="0.2" />
        </Grid>
        <Grid
            Grid.Row="1"
            VerticalOptions="Fill"
            x:Name="fightingArena"
            RowDefinitions="*, Auto"
            ColumnDefinitions="*, *"
            RowSpacing="10"
            Padding="10">
            <Label 
                InputTransparent="True"
                ZIndex="1"
                HorizontalOptions="Start"
                VerticalOptions="End" 
                FontSize="32" 
                Text="{Binding PlayerHealth}" />
            <VerticalStackLayout
                HorizontalOptions="End"
                InputTransparent="True"
                Grid.Column="1"
                ZIndex="-1">
                <Label 
                    HorizontalOptions="End"
                    Text="{Binding EnemiesHealth}"
                    FontSize="32"/>
                <Label 
                    Text="{Binding EnemiesNumber, StringFormat='Number of malwares: {0}👾'}" />
            </VerticalStackLayout>
            <Border
                StrokeShape="RoundRectangle 8"
                Stroke="Transparent"
                BackgroundColor="#121212"
                Grid.ColumnSpan="2"
                Grid.Row="2">
                <Grid
                    ColumnDefinitions="*, auto">
                    <Editor     
                        AutoSize="TextChanges"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False" 
                        Text="{Binding Code}" />
                    <Button 
                        Grid.Column="1"
                        Text="Run Your Code" 
                        Command="{Binding RequestLessonCompletionCommand}" />
                </Grid>
            </Border>
        </Grid>
        <Grid
            Grid.RowSpan="2"
            ColumnDefinitions="*, *, *"
            RowDefinitions="*, auto, auto, auto, *"
            ColumnSpacing="10"
            IsVisible="{Binding Result, Converter={StaticResource VictoryConvertor}}"
            BackgroundColor="#1c1c1c"
            Padding="10">
            <Label 
                Grid.RowSpan="4"
                Grid.ColumnSpan="3"
                Text="Victory"
                FontSize="50"
                HorizontalOptions="Center" />

            <Label 
                Grid.Row="1"
                VerticalOptions="Center"
                Text="{Binding TotalDamageDealt, StringFormat='Damage Dealt: {0}'}" />
            <Label 
                Grid.Row="2"
                VerticalOptions="Center"
                Text="{Binding TotalSelfDamage, StringFormat='Damage Taken: {0}'}" />
            <Label 
                Grid.Row="3"
                VerticalOptions="Center"
                Text="{Binding TotalXpGained, StringFormat='XP Earned: {0}'}" />
            
            <Button 
                Grid.Row="4"
                Text="Return"
                VerticalOptions="End" 
                Command="{Binding ReturnCommand}" />
            <Button 
                Grid.Row="4"
                Text="Retry" 
                Grid.Column="1"
                VerticalOptions="End" 
                Command="{Binding RetryCommand}" />
            <Button
                Grid.Row="4"
                Text="Next" 
                Grid.Column="2"
                VerticalOptions="End" 
                Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</ContentPage>