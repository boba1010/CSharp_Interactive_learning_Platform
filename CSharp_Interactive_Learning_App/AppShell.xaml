<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CSharp_Interactive_Learning_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CSharp_Interactive_Learning_App"
    xmlns:userviews="clr-namespace:CSharp_Interactive_Learning_App.Views.UserViews"
    Title="&lt;Codebase/>"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled">
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>
    
    <ShellContent
        Title="SplashScreen"
        ContentTemplate="{DataTemplate local:SplashScreen}"
        Route="SplashScreen" />

</Shell>
