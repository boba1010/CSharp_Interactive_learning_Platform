<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CSharp_Interactive_Learning_App.WinUI.Views.BattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSharp_Interactive_Learning_App.WinUI.Views"
    xmlns:sys="using:System"
    xmlns:services="using:CSharp_Interactive_Learning_App.WinUI.Services">

    <Grid
        Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsNotOver, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{ThemeResource TitleBarBackButtonStyle}" Command="{x:Bind ViewModel.EndBattleCommand}" />
            <ProgressBar 
                Grid.Column="1"
                Value="100"
                HorizontalAlignment="Stretch"/>
            <TextBlock
                FontSize="18"
                Grid.Column="2">
                <Run Text="{x:Bind ViewModel.EnemiesNumber}" />
                <Run Text="👾" />
            </TextBlock>
        </Grid>

        <Grid 
            Visibility="{x:Bind ViewModel.IsNotOver, Mode=OneWay}"
            x:Name="fightingArena" Grid.Row="1"/>
        <Grid
            Visibility="{x:Bind ViewModel.IsNotOver, Mode=OneWay}"
            Grid.Row="2" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{x:Bind ViewModel.Code, Mode=TwoWay}" />
            <Button 
                Grid.Column="1" 
                Content="Check" 
                Command="{x:Bind ViewModel.RequestRoundCompletionCommand}" />
        </Grid>

        <Grid Grid.RowSpan="3" x:Name="victoryScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <TextBlock Text="Victory!" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="32" />
            
            <StackPanel VerticalAlignment="Top" Margin="0, 50, 0, 0" HorizontalAlignment="Center" Grid.Row="1">
                <TextBlock FontSize="20" HorizontalAlignment="Center">
                    <Run Text="Total XP: " />
                    <Run Text="{x:Bind ViewModel.TotalXpGained, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="20">
                    <Run Text="Total damage dealt: " />
                    <Run Text="{x:Bind ViewModel.TotalDamageDealt, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="20">
                    <Run Text="Total damage taken: " />
                    <Run Text="{x:Bind ViewModel.TotalSelfDamage, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="20">
                    <Run Text="Total variable declared: " />
                    <Run Text="{x:Bind ViewModel.VariablesCount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="Return" Command="{x:Bind ViewModel.ReturnCommand}" />
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" />
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Next" Command="{x:Bind ViewModel.NextCommand}" />
            </Grid>
        </Grid>
        <Grid Grid.RowSpan="3" x:Name="defeatScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Defeat!" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="32" />

            <StackPanel VerticalAlignment="Top" Margin="0, 50, 0, 0" HorizontalAlignment="Center" Grid.Row="1">
                <TextBlock FontSize="20">
                    <Run Text="Total damage dealt: " />
                    <Run Text="{x:Bind ViewModel.TotalDamageDealt, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="20">
                    <Run Text="Total damage taken: " />
                    <Run Text="{x:Bind ViewModel.TotalSelfDamage, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="20">
                    <Run Text="Total variable declared: " />
                    <Run Text="{x:Bind ViewModel.VariablesCount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="Return" Command="{x:Bind ViewModel.ReturnCommand}" />
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
