<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CSharp_Interactive_Learning_App.WinUI.Views.AchievementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSharp_Interactive_Learning_App.WinUI.Views"
    xmlns:models="using:CSharp_Interactive_Learning_App.Shared.Models"
    Loaded="Page_Loaded">

    <Grid Padding="15" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Achievements" FontSize="32"/>
            <TextBlock>
                <Run Text="{x:Bind ViewModel.TotalUnlockedAchievements, Mode=OneWay}" />
                <Run Text="/" />
                <Run Text="{x:Bind ViewModel.TotalAchievements, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <GridView 
            SelectionChanged="GridView_SelectionChanged" 
            SelectionMode="Single" Grid.Row="1" 
            ItemsSource="{x:Bind ViewModel.Achievements, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Achievement">
                    <Grid 
                        CornerRadius="4" MinHeight="250"
                        MinWidth="250" MaxWidth="250"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid 
                            Grid.RowSpan="2" Visibility="{x:Bind Locked, Mode=OneWay}"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentAAFillColorDisabled}">
                            <FontIcon Glyph="&#xe72e;" FontSize="64" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Padding="10">
                            <TextBlock 
                                HorizontalAlignment="Center" 
                                Text="{x:Bind Name, Mode=OneWay}" 
                                FontSize="20" TextWrapping="Wrap"/>

                            <TextBlock 
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Text="{x:Bind Description, Mode=OneWay}" 
                                FontSize="16" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
