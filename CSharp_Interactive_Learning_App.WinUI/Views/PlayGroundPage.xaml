<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CSharp_Interactive_Learning_App.WinUI.Views.PlayGroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSharp_Interactive_Learning_App.WinUI.Views"
    xmlns:editor="using:WinUIEditor"
    xmlns:helpers="using:CSharp_Interactive_Learning_App.WinUI.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <editor:CodeEditorControl 
            Loaded="CodeEditorControl_Loaded" x:Name="codeEditor"
            Margin="0, 10, 0, 0" Background="#1c1c1c" 
            HighlightingLanguage="csharp" />

        <Border 
            Grid.Row="1" CornerRadius="12" 
            Margin="5" HorizontalAlignment="Stretch" 
            Background="{ThemeResource CardBackgroundFillColorDefault}">
            <ScrollViewer>
                <Grid RowSpacing="10" Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Run" HorizontalAlignment="Right" Command="{x:Bind ViewModel.RunCommand}" />

                    <TextBlock Text="Console" HorizontalAlignment="Left" FontSize="20"/>

                    <Border Grid.Row="2" Height="1" HorizontalAlignment="Stretch" Background="Gray"/>

                    <TextBlock 
                        Grid.Row="3"
                        VerticalAlignment="Stretch" 
                        Text="{x:Bind ViewModel.Output, Mode=OneWay}" />
                    <TextBox 
                        Grid.Row="4" 
                        VerticalAlignment="Bottom" x:Name="consoleInput"
                        KeyDown="Console_KeyDown" Visibility="{x:Bind ViewModel.IsWaitingForInput, Mode=OneWay}"/>
                </Grid>                
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
