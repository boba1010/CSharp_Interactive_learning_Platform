<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CSharp_Interactive_Learning_App.WinUI.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSharp_Interactive_Learning_App.WinUI.Views"
    Loaded="Page_Loaded">

    <ScrollView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Border 
                Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Height="160"
                Width="160"
                Padding="0"
                Margin="0, 30, 0, 0"
                CornerRadius="80"
                Background="{ThemeResource SystemAccentColorDark1}">

                <TextBlock 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="B" 
                    FontSize="50"
                    Foreground="White" />
            </Border>

            <StackPanel
                Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                Grid.Row="2"
                Grid.ColumnSpan="3"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Padding="20, 0">
                <TextBlock 
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.User.FullName, Mode=OneWay}" 
                    FontSize="20" />
                <TextBlock 
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.UserInfo, Mode=OneWay}" 
                    FontSize="12" />

                <TextBlock 
                    Text="Overview" 
                    FontSize="26"
                    Margin="0, 10, 0, 5" />
                
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" /> 
                        <RowDefinition Height="*" /> 
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="12"
                        Padding="10">
                        <Grid
                            RowDefinitions="Auto, Auto"
                            ColumnDefinitions="Auto, *"
                            RowSpacing="6">
                            <TextBlock 
                                Grid.Column="1"
                                Text="0" />
                            <TextBlock 
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="Day streak" 
                                Foreground="Gray" />
                        </Grid>
                    </Border>
                    
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="12"
                        Padding="10">
                        <Grid
                            RowDefinitions="Auto, Auto"
                            ColumnDefinitions="Auto, *"
                            RowSpacing="6">
                            <TextBlock 
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.User.TotalXp, Mode=OneWay}" />
                            <TextBlock 
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="Total XP" 
                                Foreground="Gray" />
                        </Grid>
                    </Border>
                    
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="12"
                        Padding="10">
                        <Grid
                            RowDefinitions="Auto, Auto"
                            ColumnDefinitions="Auto, *"
                            RowSpacing="6">
                            <TextBlock 
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.User.CurrentLevel, Mode=OneWay}" />
                            <TextBlock 
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="Developer Level" 
                                Foreground="Gray" />
                        </Grid>
                    </Border>
                    
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="12"
                        Padding="10">
                        <Grid
                            RowDefinitions="Auto, Auto"
                            ColumnDefinitions="Auto, *"
                            RowSpacing="6">
                            <TextBlock 
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.User.TotalPoints, Mode=OneWay}" />
                            <TextBlock 
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="Developer Points" 
                                Foreground="Gray" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <ProgressRing 
                IsHitTestVisible="False"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </ScrollView>
</Page>
