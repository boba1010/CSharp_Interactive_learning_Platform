<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CSharp_Interactive_Learning_App.WinUI.Views.LeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSharp_Interactive_Learning_App.WinUI.Views"
    xmlns:models="using:CSharp_Interactive_Learning_App.Shared.Models">

    <Grid Padding="10">
        <ListView ItemsSource="{x:Bind ViewModel.Ranks, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:UserRank">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock MinWidth="30" Text="{x:Bind Rank}" />
                        <TextBlock VerticalAlignment="Center" Grid.Column="1" Text="{x:Bind UserName}" />
                        <TextBlock MinWidth="20" HorizontalAlignment="Right" Grid.Column="2" Text="{x:Bind Points}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
