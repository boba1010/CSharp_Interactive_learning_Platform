<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CSharp_Interactive_Learning_App.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSharp_Interactive_Learning_App.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="15, 10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            HorizontalAlignment="Center">
            <Run Text="Login to " Foreground="White" FontSize="20" />
            <Run Text="&lt;" Foreground="Gray" FontSize="20" />
            <Run Text="Codebase" Foreground="RoyalBlue" FontSize="20" />
            <Run Text="/>" Foreground="Gray" FontSize="20" />
        </TextBlock>

        <Grid
            VerticalAlignment="Center"
            Grid.Row="1"
            RowSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox 
                Width="300"
                PlaceholderText="Enter your email address"
                Text="{x:Bind ViewModel.User.Email, Mode=TwoWay}"
                IsSpellCheckEnabled="False" />
            <TextBox 
                Width="300"
                Grid.Row="1" 
                PlaceholderText="Enter your password"
                Text="{x:Bind ViewModel.User.Password, Mode=TwoWay}"
                IsSpellCheckEnabled="False" />

            <TextBlock 
                Width="300"
                MinHeight="0"
                Grid.Row="2" 
                Foreground="Red" 
                Text="{x:Bind ViewModel.ErrorMsg, Mode=OneWay}" />
            <Button
                Width="300"
                HorizontalAlignment="Center"
                Grid.Row="3" 
                Content="Login" 
                Command="{x:Bind ViewModel.LoginCommand}" />
        </Grid>
        <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Row="2">
            <Button
                HorizontalAlignment="Center"
                Content="Don't have an account? Create a new account." 
                Click="OnCreateAccountButtonClick" />
            <Button 
                HorizontalAlignment="Center"
                Content="Want to test some code? Enter the Playground!" 
                Click="OnEnterPlaygroundClick" />            
        </StackPanel>
    </Grid>
</Page>
